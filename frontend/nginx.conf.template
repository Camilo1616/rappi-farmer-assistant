server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # El archivo de enlace de la app Android debe verse tal cual
    location /.well-known/ { default_type application/json; try_files $uri =404; }
    # Archivos con hash: caché larga; index.html: nunca en caché
    location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; try_files $uri =404; }
    location = /index.html { add_header Cache-Control "no-store"; }
    # Aplicación de una sola página: cualquier ruta cae en index.html
    location / { try_files $uri /index.html; }
}
