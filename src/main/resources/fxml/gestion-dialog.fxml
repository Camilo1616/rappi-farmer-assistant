<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rappi.farmer.presentation.controllers.GestionDialogController"
      spacing="16"
      style="-fx-background-color: white; -fx-padding: 28 28 20 28;"
      prefWidth="440">

    <!-- Encabezado -->
    <VBox spacing="4">
        <Label text="Registrar Gestión"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Label fx:id="lblStoreName"
               style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
    </VBox>

    <Separator/>

    <!-- Formulario -->
    <GridPane hgap="14" vgap="14">
        <columnConstraints>
            <ColumnConstraints minWidth="100" prefWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Canal:" GridPane.columnIndex="0" GridPane.rowIndex="0"
               style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
        <ComboBox fx:id="cboManagementType"
                  GridPane.columnIndex="1" GridPane.rowIndex="0"
                  maxWidth="Infinity"/>

        <Label text="Resultado:" GridPane.columnIndex="0" GridPane.rowIndex="1"
               style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
        <ComboBox fx:id="cboResultType"
                  GridPane.columnIndex="1" GridPane.rowIndex="1"
                  maxWidth="Infinity"/>

        <Label text="Comentario:" GridPane.columnIndex="0" GridPane.rowIndex="2"
               style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
        <TextArea fx:id="txtComments"
                  GridPane.columnIndex="1" GridPane.rowIndex="2"
                  prefHeight="80" wrapText="true"
                  promptText="Opcional..."/>
    </GridPane>

    <Label fx:id="lblError"
           style="-fx-text-fill: #e31837; -fx-font-size: 12px;"
           visible="false" managed="false"/>

    <!-- Botones -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#onCancelar"
                style="-fx-background-color: #ecf0f1; -fx-text-fill: #2c3e50;
                       -fx-padding: 8 20; -fx-cursor: hand; -fx-background-radius: 4;"/>
        <Button text="Guardar Gestión" onAction="#onGuardar"
                style="-fx-background-color: #e31837; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-padding: 8 20;
                       -fx-cursor: hand; -fx-background-radius: 4;"/>
    </HBox>

</VBox>
